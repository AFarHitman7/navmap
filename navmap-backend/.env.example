# Copy to .env and fill in
ADMIN_PASSWORD=change-me
DATA_DIR=./data
HOST=0.0.0.0
PORT=3000
# Enable V5 map authoring (new named geographic/static maps). Default off (reader-first):
# without it the V5 editor is read-only and V4 maps use the legacy editor. Enable deliberately
# for local development or after deploying compatible readers; see docs/map-schema-v5-rollout.md.
MAP_V5_AUTHORING_ENABLED=1
# Optional: serve a built web client from the same process (demo deploy only)
# WEB_DIST_DIR=../navmap-web/dist
# Optional: trusted TLS cert/key for phone-browser GPS testing over HTTPS
# TLS_CERT_FILE=
# TLS_KEY_FILE=
