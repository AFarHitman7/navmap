# Copy to .env for local development (never commit .env).
# Backend target for the Vite /api proxy during `npm run dev`.
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
# Phone-reachable web origin used for printed browser QR codes, e.g. https://192.168.1.20:5173.
# Never set this to localhost for printed codes.
VITE_PUBLIC_WEB_ORIGIN=http://localhost:5173
# Optional trusted-HTTPS cert/key for phone browser GPS testing (mkcert output).
VITE_HTTPS_CERT=
VITE_HTTPS_KEY=
